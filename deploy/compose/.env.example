# Настройки локального стенда. Скопируйте в .env:
#     cp .env.example .env
#
# Значения здесь — заведомо тестовые и годятся только для машины разработчика.
# Файл .env в репозиторий не попадает.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Пользователь-владелец экземпляра; роли сервисов заводит скрипт первичной
# настройки, пароль у них общий — стенд, отдельные пароли смысла не добавляют.
POSTGRES_USER=bookcase
POSTGRES_PASSWORD=bookcase
SERVICE_DB_PASSWORD=service

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Идентификатор кластера KRaft: любая строка из 22 символов base64 (16 байт).
# Задан постоянным, чтобы пересоздание тома не приводило к смене идентификатора.
KAFKA_CLUSTER_ID=bookcase-local-cluster

# ── SeaweedFS ─────────────────────────────────────────────────────────────────
# Ключи должны совпадать с seaweedfs/s3.json: тот файл читает сам SeaweedFS,
# а эти переменные получают сервисы.
STORAGE_S3_ENDPOINT=http://seaweedfs:8333
STORAGE_S3_ACCESS_KEY=storage
STORAGE_S3_SECRET_KEY=storage-secret

# Ключ подписи ссылок на скачивание — их выписывает и проверяет сам storage.
DOWNLOAD_TOKEN_SECRET=local-dev-download-secret
# Срок жизни такой ссылки. Кто её получил, тот скачает файл, поэтому срок короткий.
DOWNLOAD_TOKEN_TTL=1m

# Предел размера книги. Один и тот же для приёма и для разбора: файл, который
# взяли на хранение, должен быть разобран, а не отвергнут на следующем шаге.
MAX_FILE_SIZE=1GB
MAX_PARSE_SIZE=1GB

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ── oauth2-proxy (BFF) ────────────────────────────────────────────────────────
# Секрет клиента должен совпадать с realm-файлом keycloak/import/bookcase.json.
# Секрет cookie — ровно 32 байта, здесь в виде 32 символов.
BFF_CLIENT_ID=bookcase-bff
BFF_CLIENT_SECRET=local-dev-bff-secret
BFF_COOKIE_SECRET=bookcase-local-cookie-secret-32b

# ── Valkey ────────────────────────────────────────────────────────────────────
VALKEY_PASSWORD=valkey

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Уточнение метаданных (enricher) ───────────────────────────────────────────
# Ключ Google Books: заводится бесплатно в Google Cloud (включить Books API →
# Credentials → API key), квота 1000 запросов в сутки. Без ключа справочник
# выключается: анонимная квота общая на всех и всегда исчерпана.
# Ключ — секрет: он живёт в .env, который в git не попадает.
GOOGLE_BOOKS_API_KEY=
# Служебная учётная запись уточнителя: под ней он кладёт обложки в хранилище.
# Секрет должен совпадать с realm-файлом keycloak/import/bookcase-realm.json.
ENRICHER_CLIENT_ID=bookcase-enricher
ENRICHER_CLIENT_SECRET=local-dev-enricher-secret

# Open Library ключа не требует; её можно выключить, не убирая настройки.
OPEN_LIBRARY_ENABLED=true
# Как часто фоновый работник заглядывает в очередь и по сколько задач берёт.
ENRICH_POLL_INTERVAL=30s
ENRICH_BATCH_SIZE=10
