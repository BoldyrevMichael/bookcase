# syntax=docker/dockerfile:1

# ─────────────────────────────────────────────────────────────────────────────
# Общий образ для всех четырёх сервисов: устроены они одинаково — исполняемый архив
# Spring Boot и та же среда запуска, — и четыре отдельных файла означали бы четыре
# места, где нужно не забыть про одну и ту же правку. Различия сведены к аргументам.
#
# Общий он ровно до тех пор, пока сервисы одинаковы по форме. Понадобится одному своё —
# скажем, разбору нативная библиотека распознавания текста, а значит другой базовый
# образ, — он получает собственный файл, остальные остаются здесь. То же правило и у
# общего чарта: держать вместе стоит одинаковое, а не похожее.
#
# Сборка:  docker build -f deploy/docker/service.Dockerfile \
#            --build-arg JAR_FILE=services/catalog/build/libs/catalog-0.1.0.jar \
#            --build-arg SERVICE=catalog -t bookcase/catalog:0.1.0 .
#
# Собирается образ из готового архива, а не из исходников. В проекте с одним модулем
# сборка Gradle внутри образа хороша: версия сборщика пинится самим проектом, и всё
# делается одной командой. Здесь модулей шесть плюс включённая сборка build-logic,
# и такой путь означал бы копирование всего репозитория и повторную сборку на каждый
# из четырёх образов. Поэтому архивы собираются один раз (`./gradlew assemble`),
# а образ их только упаковывает — как это и делает конвейер: сначала сборка с тестами
# и анализаторами, потом упаковка того, что уже проверено.
# ─────────────────────────────────────────────────────────────────────────────

# ── Разбор архива на слои ────────────────────────────────────────────────────
# Spring Boot умеет раскладывать себя на слои, которые меняются с разной частотой:
# библиотеки — редко, наш код — с каждой сборкой. Слои ложатся в образ по отдельности,
# поэтому обычная пересборка добавляет мегабайты, а не полторы сотни мегабайт заново.
FROM eclipse-temurin:25-jre AS layers
WORKDIR /build
ARG JAR_FILE
COPY ${JAR_FILE} application.jar
RUN java -Djarmode=tools -jar application.jar extract --layers --destination extracted

# ── Образ, который поедет в кластер ──────────────────────────────────────────
FROM eclipse-temurin:25-jre AS runtime

# Непривилегированный пользователь: ни домашнего каталога, ни оболочки процессу
# не нужно. Заодно убираем pebble — программу на Go из базового образа Ubuntu,
# которая нам не нужна (запускается java), но приносит с собой уязвимости
# стандартной библиотеки Go при проверке образа.
RUN groupadd --gid 10001 bookcase \
    && useradd --uid 10001 --gid bookcase --no-create-home --shell /usr/sbin/nologin bookcase \
    && rm -f /usr/bin/pebble

WORKDIR /app

ARG SERVICE
ARG VERSION=0.1.0
LABEL org.opencontainers.image.title="bookcase-${SERVICE}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.description="Личная библиотека электронных книг: сервис ${SERVICE}"

# Порядок копирования — от редко меняющегося к часто меняющемуся: при пересборке
# переиспользуется как можно больше готовых слоёв.
COPY --from=layers --chown=10001:10001 /build/extracted/dependencies/ ./
COPY --from=layers --chown=10001:10001 /build/extracted/spring-boot-loader/ ./
COPY --from=layers --chown=10001:10001 /build/extracted/snapshot-dependencies/ ./
COPY --from=layers --chown=10001:10001 /build/extracted/application/ ./

USER 10001:10001

# 8080 — API, 8081 — служебный порт с пробами и метриками; наружу он не публикуется.
EXPOSE 8080 8081

# Память берётся долей от предела контейнера, а не числом: предел задан в манифесте,
# и повторять его здесь значило бы однажды с ним разойтись. Выход при нехватке памяти
# нужен, чтобы под перезапустился, а не остался наполовину живым.
# Флаги стоят в переменной, а не в ENTRYPOINT: аргументы командной строки имеют
# приоритет, и перекрыть их снаружи было бы нечем.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError"

# Форма exec: java становится процессом с номером 1 и сама получает сигнал остановки,
# а не теряет его в оболочке. Аргументы контейнера дописываются к команде.
ENTRYPOINT ["java", "-jar", "application.jar"]
