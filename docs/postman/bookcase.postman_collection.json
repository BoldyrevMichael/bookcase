                },
                {
                  "key": "client_secret",
                  "value": "{{foreignClientSecret}}"
                },
                {
                  "key": "username",
                  "value": "{{reader}}"
                },
                {
                  "key": "password",
                  "value": "{{readerPassword}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"токен выдан\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"foreignToken\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Токен чужого получателя — отказ",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{foreignToken}}"
              }
            ],
            "description": "Токен настоящий и не просрочен, но выписан не этому API: получателя bookcase-api в нём нет. Первым это замечает шлюз входа (403) — у него получатель тоже перечислен; сервис за ним проверяет получателя повторно и отвечает 401. Без этой проверки токен от соседней системы того же realm открывал бы библиотеку.",
            "url": "{{baseUrl}}/api/v1/books"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"отказ, а не выдача\", () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Без токена — 401",
          "request": {
            "method": "GET",
            "header": [],
